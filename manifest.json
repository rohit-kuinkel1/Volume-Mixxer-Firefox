{
  "manifest_version": 2,
  "name": "Volume Mixxer",
  "version": "1.6.1",
  "description": "Boost Volume up to 400%. No Elevated Permissions required. Source on Github.",
  "homepage_url": "https://github.com/rohit-kuinkel1/volume-mixxer",
  "icons": {
    "48": "images/wave.svg",
    "96": "images/wave.svg",
    "128": "images/wave.svg"
  },
  "permissions": ["activeTab", "tabs", "storage"],
  "background": {
    "scripts": ["dist/background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_icon": {
      "32": "images/wave.svg",
      "64": "images/wave.svg",
      "128": "images/wave.svg"
    },
    "default_title": "Volume Mixxer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/arrive.min.js", "dist/cs.js"],
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "_execute_browser_action": {
      "description": "Opens Volume Mixxer"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rohit.kuinkel@protonmail.com"
    }
  }
}
